<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.pexels.com/photos/8590227/pexels-photo-8590227.jpeg');">
  <div class="container">
    <h1>Find a movie to watch tonight!</h1>
    <p>Share your favorite movies with friends</p>
  </div>
</div>
<div class="container mt-3">
  <div class="row">
    <div class="col-9">
      <ul>
        <% @lists.each do |list| %>
          <li><%= link_to list.name, list_path(list)  %></li>
        <% end %>
      </ul>
    </div>

    <div class="col-3">
      <%= link_to "Add a New List", new_list_path, class: "btn btn-warning" %>
    </div>
  
  </div>
</div>
